<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OnnxRuntimeFlavor Condition="'$(OnnxRuntimeFlavor)' == ''">cpu</OnnxRuntimeFlavor>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxTransformer" Version="5.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <!-- PP-OCR's DB post-process needs contours, min-area boxes and perspective crops. -->
    <!-- Match the frozen PaddleOCR validation runtime's OpenCV 4.11 geometry exactly. -->
    <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
    <!-- The supported delivery target is Windows x64. This package supplies OpenCV native binaries. -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />
    <!-- Managed polygon offsetting used by Paddle DB's unclip step. -->
    <PackageReference Include="Clipper2" Version="1.5.4" />
  </ItemGroup>

  <!-- Build with -p:OnnxRuntimeFlavor=gpu for CUDA deployment. -->
  <ItemGroup Condition="'$(OnnxRuntimeFlavor)' == 'cpu'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(OnnxRuntimeFlavor)' == 'gpu'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.23.2" />
  </ItemGroup>
</Project>
