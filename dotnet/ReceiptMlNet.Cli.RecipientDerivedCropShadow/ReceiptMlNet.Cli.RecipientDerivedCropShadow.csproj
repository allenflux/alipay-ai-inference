<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OnnxRuntimeFlavor Condition="'$(OnnxRuntimeFlavor)' == ''">cpu</OnnxRuntimeFlavor>
  </PropertyGroup>

  <Target Name="RequireCpuOnnxRuntimeFlavor" BeforeTargets="PrepareForBuild"
          Condition="'$(OnnxRuntimeFlavor)' != 'cpu'">
    <Error Text="ReceiptMlNet.Cli.RecipientDerivedCropShadow is CPU-only; OnnxRuntimeFlavor must be cpu." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\ReceiptMlNet.Cli\ReceiptMlNet.Cli.csproj"
                      AdditionalProperties="OnnxRuntimeFlavor=cpu" />
  </ItemGroup>
</Project>
